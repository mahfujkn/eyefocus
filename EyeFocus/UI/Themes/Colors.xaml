<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme (EyeFocus Glassmorphism Utility Design) -->
    <Color x:Key="PrimaryColor">#2DD4BF</Color>
    <Color x:Key="OnPrimaryColor">#04211E</Color>
    <Color x:Key="PrimaryContainerColor">#134E4A</Color>
    <Color x:Key="OnPrimaryContainerColor">#99F6E4</Color>

    <Color x:Key="SecondaryColor">#97A3AD</Color>
    <Color x:Key="OnSecondaryColor">#0A0D12</Color>
    <Color x:Key="SecondaryContainerColor">#161D26</Color>
    <Color x:Key="OnSecondaryContainerColor">#EAF0F4</Color>

    <Color x:Key="TertiaryColor">#38BDF8</Color>
    <Color x:Key="OnTertiaryColor">#0A0D12</Color>
    <Color x:Key="TertiaryContainerColor">#0C4A6E</Color>
    <Color x:Key="OnTertiaryContainerColor">#E0F2FE</Color>

    <Color x:Key="SurfaceColor">#0A0D12</Color>
    <Color x:Key="SurfaceDimColor">#070A0E</Color>
    <Color x:Key="SurfaceBrightColor">#1A212D</Color>
    <Color x:Key="SurfaceContainerLowestColor">#06080B</Color>
    <Color x:Key="SurfaceContainerLowColor">#0D1117</Color>
    <Color x:Key="SurfaceContainerColor">#131821</Color>
    <Color x:Key="SurfaceContainerHighColor">#1C2330</Color>
    <Color x:Key="SurfaceContainerHighestColor">#263042</Color>

    <Color x:Key="OnSurfaceColor">#EAF0F4</Color>
    <Color x:Key="OnSurfaceVariantColor">#97A3AD</Color>
    <Color x:Key="OutlineColor">#5C6772</Color>
    <Color x:Key="OutlineVariantColor">#202936</Color>

    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="OnErrorColor">#450A0A</Color>
    <Color x:Key="ErrorContainerColor">#7F1D1D</Color>
    <Color x:Key="OnErrorContainerColor">#FEE2E2</Color>

    <Color x:Key="SuccessColor">#2DD4BF</Color>
    <Color x:Key="WarmAccentColor">#F59E0B</Color>
    <Color x:Key="CoolAccentColor">#38BDF8</Color>
    <Color x:Key="NightAccentColor">#7DD3FC</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}" />

    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainerColor}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceDimBrush" Color="{StaticResource SurfaceDimColor}" />
    <SolidColorBrush x:Key="SurfaceBrightBrush" Color="{StaticResource SurfaceBrightColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />

    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccentColor}" />
    <SolidColorBrush x:Key="CoolAccentBrush" Color="{StaticResource CoolAccentColor}" />
    <SolidColorBrush x:Key="NightAccentBrush" Color="{StaticResource NightAccentColor}" />

    <!-- Sliders Track Fills from Redesign Concept (Solid left-fill matching mockup) -->
    <SolidColorBrush x:Key="SliderBrightnessFillBrush" Color="#00A88F" />
    <SolidColorBrush x:Key="SliderKelvinFillBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="BrightnessTrackBrush" Color="#00A88F" />
    <SolidColorBrush x:Key="KelvinTrackBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="SliderRedFillBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="SliderGreenFillBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SliderBlueFillBrush" Color="#3B82F6" />

    <!-- Day & Night Automation Sub-Cards (Themed) -->
    <Color x:Key="DayModeCardBackgroundColor">#1C1914</Color>
    <Color x:Key="DayModeCardBorderColor">#3D2E14</Color>
    <Color x:Key="DayModeTimeBadgeBackgroundColor">#2E1E05</Color>
    <Color x:Key="DayModeTimeBadgeForegroundColor">#FCD34D</Color>
    <Color x:Key="DayModeTimeBadgeBorderColor">#5C3B08</Color>
    <Color x:Key="DayModeIconCircleBackgroundColor">#332104</Color>

    <Color x:Key="NightModeCardBackgroundColor">#101726</Color>
    <Color x:Key="NightModeCardBorderColor">#1E293B</Color>
    <Color x:Key="NightModeTimeBadgeBackgroundColor">#0C2542</Color>
    <Color x:Key="NightModeTimeBadgeForegroundColor">#93C5FD</Color>
    <Color x:Key="NightModeTimeBadgeBorderColor">#1E3A8A</Color>
    <Color x:Key="NightModeIconCircleBackgroundColor">#142540</Color>
    <Color x:Key="NightModeIconCircleForegroundColor">#60A5FA</Color>

    <!-- Header Icon Circles (Themed) -->
    <Color x:Key="BrightnessHeaderCircleBgColor">#0D332D</Color>
    <Color x:Key="BrightnessHeaderCircleFgColor">#2DD4BF</Color>
    <Color x:Key="KelvinHeaderCircleBgColor">#3D2406</Color>
    <Color x:Key="KelvinHeaderCircleFgColor">#FBBF24</Color>
    <Color x:Key="ScheduleHeaderCircleBgColor">#0E2C4A</Color>
    <Color x:Key="ScheduleHeaderCircleFgColor">#38BDF8</Color>
    <Color x:Key="ProfilesHeaderCircleBgColor">#1E293B</Color>
    <Color x:Key="ProfilesHeaderCircleFgColor">#94A3B8</Color>

    <!-- Value Badges (Themed) -->
    <Color x:Key="BrightnessBadgeBackgroundColor">#1E293B</Color>
    <Color x:Key="BrightnessBadgeForegroundColor">#F8FAFC</Color>
    <Color x:Key="BrightnessBadgeBorderColor">#334155</Color>
    <Color x:Key="KelvinBadgeBackgroundColor">#382305</Color>
    <Color x:Key="KelvinBadgeForegroundColor">#FBBF24</Color>
    <Color x:Key="KelvinBadgeBorderColor">#5C3B08</Color>

    <!-- Timeline Track (Themed) -->
    <Color x:Key="TimelineNightTrackColor">#334155</Color>

    <!-- Corresponding SolidColorBrushes -->
    <SolidColorBrush x:Key="DayModeCardBackgroundBrush" Color="{StaticResource DayModeCardBackgroundColor}" />
    <SolidColorBrush x:Key="DayModeCardBorderBrush" Color="{StaticResource DayModeCardBorderColor}" />
    <SolidColorBrush x:Key="DayModeTimeBadgeBackgroundBrush" Color="{StaticResource DayModeTimeBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="DayModeTimeBadgeForegroundBrush" Color="{StaticResource DayModeTimeBadgeForegroundColor}" />
    <SolidColorBrush x:Key="DayModeTimeBadgeBorderBrush" Color="{StaticResource DayModeTimeBadgeBorderColor}" />
    <SolidColorBrush x:Key="DayModeIconCircleBackgroundBrush" Color="{StaticResource DayModeIconCircleBackgroundColor}" />

    <SolidColorBrush x:Key="NightModeCardBackgroundBrush" Color="{StaticResource NightModeCardBackgroundColor}" />
    <SolidColorBrush x:Key="NightModeCardBorderBrush" Color="{StaticResource NightModeCardBorderColor}" />
    <SolidColorBrush x:Key="NightModeTimeBadgeBackgroundBrush" Color="{StaticResource NightModeTimeBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="NightModeTimeBadgeForegroundBrush" Color="{StaticResource NightModeTimeBadgeForegroundColor}" />
    <SolidColorBrush x:Key="NightModeTimeBadgeBorderBrush" Color="{StaticResource NightModeTimeBadgeBorderColor}" />
    <SolidColorBrush x:Key="NightModeIconCircleBackgroundBrush" Color="{StaticResource NightModeIconCircleBackgroundColor}" />
    <SolidColorBrush x:Key="NightModeIconCircleForegroundBrush" Color="{StaticResource NightModeIconCircleForegroundColor}" />

    <SolidColorBrush x:Key="BrightnessHeaderCircleBgBrush" Color="{StaticResource BrightnessHeaderCircleBgColor}" />
    <SolidColorBrush x:Key="BrightnessHeaderCircleFgBrush" Color="{StaticResource BrightnessHeaderCircleFgColor}" />
    <SolidColorBrush x:Key="KelvinHeaderCircleBgBrush" Color="{StaticResource KelvinHeaderCircleBgColor}" />
    <SolidColorBrush x:Key="KelvinHeaderCircleFgBrush" Color="{StaticResource KelvinHeaderCircleFgColor}" />
    <SolidColorBrush x:Key="ScheduleHeaderCircleBgBrush" Color="{StaticResource ScheduleHeaderCircleBgColor}" />
    <SolidColorBrush x:Key="ScheduleHeaderCircleFgBrush" Color="{StaticResource ScheduleHeaderCircleFgColor}" />
    <SolidColorBrush x:Key="ProfilesHeaderCircleBgBrush" Color="{StaticResource ProfilesHeaderCircleBgColor}" />
    <SolidColorBrush x:Key="ProfilesHeaderCircleFgBrush" Color="{StaticResource ProfilesHeaderCircleFgColor}" />

    <SolidColorBrush x:Key="BrightnessBadgeBackgroundBrush" Color="{StaticResource BrightnessBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="BrightnessBadgeForegroundBrush" Color="{StaticResource BrightnessBadgeForegroundColor}" />
    <SolidColorBrush x:Key="BrightnessBadgeBorderBrush" Color="{StaticResource BrightnessBadgeBorderColor}" />
    <SolidColorBrush x:Key="KelvinBadgeBackgroundBrush" Color="{StaticResource KelvinBadgeBackgroundColor}" />
    <SolidColorBrush x:Key="KelvinBadgeForegroundBrush" Color="{StaticResource KelvinBadgeForegroundColor}" />
    <SolidColorBrush x:Key="KelvinBadgeBorderBrush" Color="{StaticResource KelvinBadgeBorderColor}" />

    <SolidColorBrush x:Key="TimelineNightTrackBrush" Color="{StaticResource TimelineNightTrackColor}" />

    <!-- Teal Button Primary Gradient -->
    <LinearGradientBrush x:Key="TealPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0.0" />
        <GradientStop Color="#0D9488" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Ambient Status Strip Gradient -->
    <LinearGradientBrush x:Key="StatusStripGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22F59E0B" Offset="0.0" />
        <GradientStop Color="#00F59E0B" Offset="0.7" />
    </LinearGradientBrush>

    <!-- Day/Night Automation Card Gradient -->
    <LinearGradientBrush x:Key="DayNightCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1838BDF8" Offset="0.0" />
        <GradientStop Color="#12F59E0B" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
