<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme (EyeFocus Glassmorphism Utility Design) -->
    <Color x:Key="PrimaryColor">#2DD4BF</Color>
    <Color x:Key="OnPrimaryColor">#04211E</Color>
    <Color x:Key="PrimaryContainerColor">#134E4A</Color>
    <Color x:Key="OnPrimaryContainerColor">#99F6E4</Color>

    <Color x:Key="SecondaryColor">#97A3AD</Color>
    <Color x:Key="OnSecondaryColor">#0A0D12</Color>
    <Color x:Key="SecondaryContainerColor">#161D26</Color>
    <Color x:Key="OnSecondaryContainerColor">#EAF0F4</Color>

    <Color x:Key="TertiaryColor">#38BDF8</Color>
    <Color x:Key="OnTertiaryColor">#0A0D12</Color>
    <Color x:Key="TertiaryContainerColor">#0C4A6E</Color>
    <Color x:Key="OnTertiaryContainerColor">#E0F2FE</Color>

    <Color x:Key="SurfaceColor">#0A0D12</Color>
    <Color x:Key="SurfaceDimColor">#070A0E</Color>
    <Color x:Key="SurfaceBrightColor">#1A212D</Color>
    <Color x:Key="SurfaceContainerLowestColor">#06080B</Color>
    <Color x:Key="SurfaceContainerLowColor">#0D1117</Color>
    <Color x:Key="SurfaceContainerColor">#131821</Color>
    <Color x:Key="SurfaceContainerHighColor">#1C2330</Color>
    <Color x:Key="SurfaceContainerHighestColor">#263042</Color>

    <Color x:Key="OnSurfaceColor">#EAF0F4</Color>
    <Color x:Key="OnSurfaceVariantColor">#97A3AD</Color>
    <Color x:Key="OutlineColor">#5C6772</Color>
    <Color x:Key="OutlineVariantColor">#202936</Color>

    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="OnErrorColor">#450A0A</Color>
    <Color x:Key="ErrorContainerColor">#7F1D1D</Color>
    <Color x:Key="OnErrorContainerColor">#FEE2E2</Color>

    <Color x:Key="SuccessColor">#2DD4BF</Color>
    <Color x:Key="WarmAccentColor">#F59E0B</Color>
    <Color x:Key="CoolAccentColor">#38BDF8</Color>
    <Color x:Key="NightAccentColor">#7DD3FC</Color>

    <!-- Solid Color Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}" />
    <SolidColorBrush x:Key="OnPrimaryContainerBrush" Color="{StaticResource OnPrimaryContainerColor}" />

    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="OnSecondaryBrush" Color="{StaticResource OnSecondaryColor}" />
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}" />
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}" />

    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource TertiaryColor}" />
    <SolidColorBrush x:Key="OnTertiaryBrush" Color="{StaticResource OnTertiaryColor}" />
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}" />
    <SolidColorBrush x:Key="OnTertiaryContainerBrush" Color="{StaticResource OnTertiaryContainerColor}" />

    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceDimBrush" Color="{StaticResource SurfaceDimColor}" />
    <SolidColorBrush x:Key="SurfaceBrightBrush" Color="{StaticResource SurfaceBrightColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}" />
    <SolidColorBrush x:Key="SurfaceContainerLowBrush" Color="{StaticResource SurfaceContainerLowColor}" />
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}" />
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}" />

    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurfaceColor}" />
    <SolidColorBrush x:Key="OnSurfaceVariantBrush" Color="{StaticResource OnSurfaceVariantColor}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineColor}" />
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}" />

    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="OnErrorBrush" Color="{StaticResource OnErrorColor}" />
    <SolidColorBrush x:Key="ErrorContainerBrush" Color="{StaticResource ErrorContainerColor}" />
    <SolidColorBrush x:Key="OnErrorContainerBrush" Color="{StaticResource OnErrorContainerColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccentColor}" />
    <SolidColorBrush x:Key="CoolAccentBrush" Color="{StaticResource CoolAccentColor}" />
    <SolidColorBrush x:Key="NightAccentBrush" Color="{StaticResource NightAccentColor}" />

    <!-- Sliders Track Gradients from Redesign Concept -->
    <!-- Thermal Kelvin Gradient: Warm Amber -> Pale Yellow -> Daylight Neutral -> Cool Sky Blue -->
    <LinearGradientBrush x:Key="KelvinTrackBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F59E0B" Offset="0.0" />  <!-- Warm Amber (2500K) -->
        <GradientStop Color="#F7D774" Offset="0.45" /> <!-- Soft Warm (4500K) -->
        <GradientStop Color="#D9E7F2" Offset="0.70" /> <!-- Daylight Neutral (5500K) -->
        <GradientStop Color="#38BDF8" Offset="1.0" />  <!-- Cool Sky Blue (7500K) -->
    </LinearGradientBrush>

    <!-- Brightness Teal Gradient: Deep Dim Teal -> Glowing EyeFocus Teal -->
    <LinearGradientBrush x:Key="BrightnessTrackBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#134E4A" Offset="0.0" />
        <GradientStop Color="#0D9488" Offset="0.5" />
        <GradientStop Color="#2DD4BF" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Teal Button Primary Gradient -->
    <LinearGradientBrush x:Key="TealPrimaryButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0.0" />
        <GradientStop Color="#0D9488" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Ambient Status Strip Gradient -->
    <LinearGradientBrush x:Key="StatusStripGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22F59E0B" Offset="0.0" />
        <GradientStop Color="#00F59E0B" Offset="0.7" />
    </LinearGradientBrush>

    <!-- Day/Night Automation Card Gradient -->
    <LinearGradientBrush x:Key="DayNightCardGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#1838BDF8" Offset="0.0" />
        <GradientStop Color="#12F59E0B" Offset="1.0" />
    </LinearGradientBrush>

</ResourceDictionary>
