<UserControl x:Class="EyeFocus.UI.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="840"
             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,32" HorizontalAlignment="Stretch" MaxWidth="720">

            <!-- 1. Hero Branding Section -->
            <StackPanel HorizontalAlignment="Center" Margin="0,8,0,24">
                <!-- App Icon with Teal Gradient Surface -->
                <Border Width="56" Height="56" CornerRadius="16"
                        Background="{StaticResource TealPrimaryButtonBrush}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,14">
                    <Path Data="{StaticResource IconEyeFocusBrand}"
                          Fill="{DynamicResource OnPrimaryBrush}"
                          Width="30" Height="30" Stretch="Uniform"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Title & Version Badge -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <TextBlock Text="EyeFocus" FontWeight="Bold" FontSize="26"
                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"
                               Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                    <Border Background="{DynamicResource PrimaryContainerBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="8,2.5" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Version}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource PrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Tagline -->
                <TextBlock Text="{Binding Tagline}" FontWeight="SemiBold" FontSize="13.5"
                           Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />

                <!-- Description -->
                <TextBlock Text="{Binding Description}"
                           FontSize="12" Foreground="{DynamicResource OutlineBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" LineHeight="19"
                           MaxWidth="580" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 2. Official Repository & Releases Card -->
            <Border Background="{DynamicResource SurfaceBrightBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="16"
                    Padding="22,18" Margin="0,0,0,16"
                    HorizontalAlignment="Stretch">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- GitHub Circle Icon -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                Background="{DynamicResource ScheduleHeaderCircleBgBrush}"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource ScheduleHeaderCircleFgBrush}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Official Repository &amp; Releases" FontWeight="Bold" FontSize="15"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="EyeFocus is fully open-source under the MIT license. Star, inspect, or contribute on GitHub:"
                                       FontSize="11.5" Foreground="{DynamicResource OutlineBrush}"
                                       TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="54,0,0,0">
                        <!-- View on GitHub Button (Filled Primary Solid) -->
                        <Button Style="{StaticResource M3FilledButtonStyle}" Command="{Binding OpenRepositoryCommand}"
                                Margin="0,0,10,0" Padding="14,6" Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource OnPrimaryBrush}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="View on GitHub" Foreground="{DynamicResource OnPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconExternalLink}" Fill="{DynamicResource OnPrimaryBrush}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Official Releases Button (Tonal Secondary) -->
                        <Button Style="{StaticResource M3TonalButtonStyle}" Command="{Binding OpenReleasesCommand}"
                                Padding="14,6" Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconExternalLink}" Fill="{DynamicResource OnSecondaryContainerBrush}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="Official Releases" Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Developer Card -->
            <Border Background="{DynamicResource SurfaceBrightBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                    BorderThickness="1" CornerRadius="16"
                    Padding="22,18" HorizontalAlignment="Stretch">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Developer Circle Icon -->
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                Background="{DynamicResource BrightnessHeaderCircleBgBrush}"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconFocus}" Fill="{DynamicResource BrightnessHeaderCircleFgBrush}"
                                  Width="18" Height="18" Stretch="Uniform"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Developed By" FontWeight="SemiBold" FontSize="11"
                                       Foreground="{DynamicResource OutlineBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DeveloperName, Mode=OneWay}"
                                       FontSize="15.5" FontWeight="Bold"
                                       Foreground="{DynamicResource OnSurfaceBrush}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="54,0,0,0">
                        <Button Style="{StaticResource M3FilledButtonStyle}" Command="{Binding OpenDeveloperCommand}"
                                Padding="14,6" Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconGitHub}" Fill="{DynamicResource OnPrimaryBrush}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="GitHub Profile" Foreground="{DynamicResource OnPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconExternalLink}" Fill="{DynamicResource OnPrimaryBrush}"
                                      Width="10" Height="10" Stretch="Uniform" Margin="7,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
