<UserControl x:Class="EyeFocus.UI.Views.ProfileEditorModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             FontFamily="Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled"
             d:DesignHeight="700" d:DesignWidth="540">

    <Border Background="{DynamicResource SurfaceContainerBrush}"
            BorderBrush="{DynamicResource OutlineVariantBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. FIXED HEADER (Never scrolls away) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="13,13,0,0"
                    Padding="18,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource TealPrimaryButtonBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconEdit}" Fill="#04211E" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Custom Profile Editor" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="Adjust lighting, temperature, and RGB balances" FontSize="10.5" Foreground="{DynamicResource OutlineBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource M3SwitchStyle}" IsChecked="{Binding IsLivePreviewEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="Live Preview" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" />
                        </CheckBox>
                        <Button Style="{StaticResource M3IconButtonStyle}" Command="{Binding CancelCommand}" Width="26" Height="26" Padding="0" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Fill="{DynamicResource OnSurfaceVariantBrush}" Width="9" Height="9" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 1. SCROLLABLE BODY CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,12">
                <StackPanel>
                    <!-- A. Profile Info Card -->
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Profile Name -->
                            <TextBlock Text="Profile Name" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource M3TextBoxStyle}"
                                     Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10" />

                            <!-- Description / Comfort Note -->
                            <TextBlock Text="Description &amp; Comfort Note" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,4" />
                            <TextBox Style="{StaticResource M3TextBoxStyle}"
                                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Border>

                    <!-- B. Temperature & Brightness Card -->
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Color Temperature -->
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconThermometer}" Fill="{DynamicResource KelvinBadgeForegroundBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Color Temperature" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{DynamicResource KelvinBadgeBackgroundBrush}" BorderBrush="{DynamicResource KelvinBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Kelvin, StringFormat='{}{0}K'}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource KelvinBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="2500" Maximum="7500" SmallChange="50" LargeChange="250"
                                    Value="{Binding Kelvin, Mode=TwoWay}" Tag="{StaticResource KelvinTrackBrush}" Margin="0,0,0,12" />

                            <!-- Brightness -->
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconSun}" Fill="{DynamicResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Brightness" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Background="{DynamicResource BrightnessBadgeBackgroundBrush}" BorderBrush="{DynamicResource BrightnessBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource BrightnessBadgeForegroundBrush}" />
                                </Border>
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                    Value="{Binding Brightness, Mode=TwoWay}" Tag="{StaticResource BrightnessTrackBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- C. RGB Color Balance Card -->
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="RGB Color Balance" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource OnSurfaceBrush}" Margin="0,0,0,10" />

                            <!-- Red Channel -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#EF4444" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Red Channel" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Red, StringFormat='{}{0}%'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="0" Maximum="100" Value="{Binding Red, Mode=TwoWay}" Tag="{StaticResource SliderRedFillBrush}" Margin="0,0,0,8" />

                            <!-- Green Channel -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Green Channel" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Green, StringFormat='{}{0}%'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="0" Maximum="100" Value="{Binding Green, Mode=TwoWay}" Tag="{StaticResource SliderGreenFillBrush}" Margin="0,0,0,8" />

                            <!-- Blue Channel -->
                            <Grid Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Blue Channel" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding Blue, StringFormat='{}{0}%'}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="0" Maximum="100" Value="{Binding Blue, Mode=TwoWay}" Tag="{StaticResource SliderBlueFillBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- D. Software Dim, Contrast & Transition Card -->
                    <Border Background="{DynamicResource SurfaceContainerLowBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,4">
                        <StackPanel>
                            <!-- Software Dim -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Software Dim Overlay" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SoftwareDim, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="0" Maximum="80" SmallChange="1" Value="{Binding SoftwareDim, Mode=TwoWay}" Tag="{StaticResource PrimaryBrush}" Margin="0,0,0,8" />

                            <!-- Contrast -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Contrast Factor" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Contrast, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="10" Maximum="90" SmallChange="1" Value="{Binding Contrast, Mode=TwoWay}" Tag="{DynamicResource PrimaryBrush}" Margin="0,0,0,8" />

                            <!-- Transition Duration -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Transition Duration" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TransitionDuration, StringFormat='{}{0}s'}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource OnSurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Slider Style="{StaticResource M3SliderStyle}" Minimum="0" Maximum="30" SmallChange="1" Value="{Binding TransitionDuration, Mode=TwoWay}" Tag="{StaticResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 2. FIXED FOOTER ACTION BUTTONS (Never scrolls away) -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceContainerLowBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}"
                    BorderThickness="0,1,0,0"
                    CornerRadius="0,0,13,13"
                    Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Style="{StaticResource M3OutlinedButtonStyle}" Command="{Binding ResetCommand}" IsEnabled="{Binding IsBuiltIn}" Content="Reset to Default" Height="30" Padding="10,4" />
                    <Button Grid.Column="2" Style="{StaticResource M3TonalButtonStyle}" Command="{Binding CancelCommand}" Content="Cancel" Height="30" Padding="12,4" />
                    <Button Grid.Column="4" Style="{StaticResource M3TonalButtonStyle}" Command="{Binding SaveAsNewCommand}" Content="Save as New" Height="30" Padding="12,4" />
                    <Button Grid.Column="6" Style="{StaticResource M3FilledButtonStyle}" Command="{Binding SaveCommand}" Height="30" Padding="14,4">
                        <TextBlock Text="Save Profile" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
