<UserControl x:Class="EyeFocus.UI.Views.DisplayDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="680" d:DesignWidth="680"
             FontFamily="Segoe UI"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             RenderOptions.ClearTypeHint="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Content Container (Generous cards filling vertical space comfortably without default scrollbar) -->
        <StackPanel Margin="20,10,20,14" HorizontalAlignment="Stretch">

            <!-- 1. PAGE HEADER & PAUSE ACTION -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Display" FontWeight="Bold" FontSize="20" Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="Control brightness, color temperature, and display profiles." FontSize="12" Foreground="{DynamicResource OutlineBrush}" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Pause / Resume Action Button -->
                <Button Grid.Column="1" Style="{StaticResource M3TonalButtonStyle}" Command="{Binding TogglePauseCommand}"
                        Padding="11,4" Height="27" VerticalAlignment="Center" ToolTip="{Binding PauseButtonToolTip}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconPause}" />
                                    <Setter Property="Fill" Value="{DynamicResource OnSecondaryContainerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource IconPlay}" />
                                            <Setter Property="Fill" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="{Binding PauseButtonText}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainerBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. BRIGHTNESS CARD -->
            <Border Style="{StaticResource M3CardStyle}" Margin="0,0,0,10" Padding="16,10">
                <StackPanel>
                    <!-- Control Row: Icon + Label on Left, Value on Right -->
                    <Grid Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSun}" Fill="{DynamicResource OnSurfaceVariantBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="BRIGHTNESS" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}"
                                   FontWeight="Bold" FontSize="17"
                                   Foreground="{DynamicResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Brightness Slider with Glowing Teal Track -->
                    <Slider Style="{StaticResource M3SliderStyle}"
                            Value="{Binding Brightness, Mode=TwoWay}"
                            Minimum="10" Maximum="100"
                            SmallChange="5" LargeChange="10"
                            Tag="{StaticResource BrightnessTrackBrush}"
                            Margin="0,2,0,3" />

                    <!-- Slider Footer: Hardware Badge + Reset -->
                    <Grid Margin="0,2,0,0">
                        <Border Background="{DynamicResource SurfaceContainerHighBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HardwareControlBadgeText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="More Dim → More Bright" FontSize="10" Foreground="{DynamicResource OutlineBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource M3TonalButtonStyle}" Command="{Binding ResetBrightnessCommand}" Padding="8,2" Height="21" ToolTip="Reset brightness to profile default">
                                <TextBlock Text="Reset" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. COLOR TEMPERATURE CARD -->
            <Border Style="{StaticResource M3CardStyle}" Margin="0,0,0,10" Padding="16,10">
                <StackPanel>
                    <!-- Control Row: Icon + Label on Left, Amber Value on Right -->
                    <Grid Margin="0,0,0,3">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconComfort}" Fill="{DynamicResource OnSurfaceVariantBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="COLOR TEMPERATURE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Kelvin, StringFormat='{}{0}K'}"
                                   FontWeight="Bold" FontSize="17"
                                   Foreground="{DynamicResource WarmAccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Kelvin Slider with Thermal Spectrum Track -->
                    <Slider Style="{StaticResource M3SliderStyle}"
                            Value="{Binding Kelvin, Mode=TwoWay}"
                            Minimum="2500" Maximum="7500"
                            SmallChange="100" LargeChange="500"
                            Tag="{StaticResource KelvinTrackBrush}"
                            Margin="0,2,0,3" />

                    <!-- Slider Meta & Reset -->
                    <Grid Margin="0,2,0,0">
                        <TextBlock Text="2500K · More Warm" FontSize="10" Foreground="{DynamicResource OutlineBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="7500K · Less Warm" FontSize="10" Foreground="{DynamicResource OutlineBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Button Style="{StaticResource M3TonalButtonStyle}" Command="{Binding ResetKelvinCommand}" Padding="8,2" Height="21" ToolTip="Reset color temperature to profile default">
                                <TextBlock Text="Reset" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. DAY & NIGHT CARD (Ambient-Tinted Automation Card with 8px Radius) -->
            <Border CornerRadius="8" Background="{StaticResource DayNightCardGradientBrush}"
                    BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1"
                    Padding="16,10" Margin="0,0,0,10">
                <StackPanel>
                    <!-- Header with Automation Switch & Configure Button -->
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconSun}" Fill="{DynamicResource WarmAccentBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="DAY &amp; NIGHT" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource SurfaceContainerHighBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AutoDayNightStatusText}" FontSize="9.5" Foreground="{DynamicResource PrimaryBrush}" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource M3SwitchStyle}" IsChecked="{Binding IsAutomaticDayNightEnabled, Mode=TwoWay}" ToolTip="Toggle automatic day/night switching">
                                <TextBlock Text="Automatic" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                            </CheckBox>

                            <Button Style="{StaticResource M3TonalButtonStyle}" Command="{Binding ConfigureAutoDayNightCommand}" Margin="10,0,0,0" Padding="8,2" Height="22" ToolTip="Configure day/night schedule times">
                                <TextBlock Text="Configure" FontSize="10" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Day / Night 2-Column Grid -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Day Mode Tile -->
                        <Button Grid.Column="0" Command="{Binding SelectDayModeCommand}"
                                Padding="10,8" Height="48" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Icon Box -->
                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#24F59E0B" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconSun}" Fill="#FBBF24" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Center: Title + Subtitle -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Day Mode" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                            <TextBlock Text="Balanced Daylight" FontSize="10" Foreground="{DynamicResource OutlineBrush}" Margin="0,1,0,0" />
                                                        </StackPanel>

                                                        <!-- Right: Values + Time -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding DayModeDetails}" FontWeight="Bold" FontSize="11" Foreground="#FBBF24" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding DayStartTimeDisplay}" FontSize="9" Foreground="{DynamicResource OutlineBrush}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsDayModeActive}" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Night Mode Tile -->
                        <Button Grid.Column="2" Command="{Binding SelectNightModeCommand}"
                                Padding="10,8" Height="48" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="SnapsToDevicePixels" Value="True" />
                                    <Setter Property="UseLayoutRounding" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="8" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Left Icon Box -->
                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6" Background="#2438BDF8" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource IconNight}" Fill="#7DD3FC" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>

                                                        <!-- Center: Title + Subtitle -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="Night Mode" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                            <TextBlock Text="Warm &amp; Relaxed" FontSize="10" Foreground="{DynamicResource OutlineBrush}" Margin="0,1,0,0" />
                                                        </StackPanel>

                                                        <!-- Right: Values + Time -->
                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding NightModeDetails}" FontWeight="Bold" FontSize="11" Foreground="#7DD3FC" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding NightStartTimeDisplay}" FontSize="9" Foreground="{DynamicResource OutlineBrush}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNightModeActive}" Value="True">
                                                        <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                                                        <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter TargetName="BtnBorder" Property="BorderThickness" Value="1.5" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 5. DISPLAY PROFILES (Generous 54px Tiles Filling Bottom Space Beautifully) -->
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="DISPLAY PROFILES" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />

                    <Button Style="{StaticResource M3TonalButtonStyle}" Command="{Binding RestoreDisplayCommand}" HorizontalAlignment="Right" Padding="8,3" Height="24" ToolTip="Restore display to Comfort default">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconReset}" Fill="{DynamicResource OnSecondaryContainerBrush}" Width="9" Height="9" Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center" />
                            <TextBlock Text="Restore Display" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 3x3 Profiles UniformGrid (Generous 52px Tiles Filling Empty Bottom Area) -->
                <ItemsControl ItemsSource="{Binding ProfileCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Id}"
                                    Margin="3" Padding="10,8" Height="52"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="SnapsToDevicePixels" Value="True" />
                                        <Setter Property="UseLayoutRounding" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="TileBorder"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1.5"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}"
                                                            SnapsToDevicePixels="True"
                                                            UseLayoutRounding="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- Icon Box -->
                                                            <Border Grid.Column="0" x:Name="IconBox" Width="30" Height="30" CornerRadius="6" Background="{DynamicResource SurfaceContainerHighBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                                <Path x:Name="IconPath"
                                                                      Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                                      Fill="{DynamicResource OnSurfaceVariantBrush}"
                                                                      Width="14" Height="14" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Name & Params -->
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock x:Name="ProfileNameText" Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                                <TextBlock Text="{Binding FormattedParams}" FontSize="10" Foreground="{DynamicResource OutlineBrush}" Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <!-- Checkmark Circle when Active -->
                                                            <Border Grid.Column="2" x:Name="ActiveCheck"
                                                                    Width="16" Height="16" CornerRadius="8"
                                                                    Background="{DynamicResource PrimaryBrush}"
                                                                    Visibility="Collapsed"
                                                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                                                <Path Data="{StaticResource IconCheck}"
                                                                      Fill="{DynamicResource OnPrimaryBrush}"
                                                                      Width="8.5" Height="8.5" Stretch="Uniform"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}" />
                                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource PrimaryContainerBrush}" />
                                                            <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                            <Setter TargetName="TileBorder" Property="BorderThickness" Value="1.5" />
                                                            <Setter TargetName="IconBox" Property="Background" Value="{DynamicResource PrimaryBrush}" />
                                                            <Setter TargetName="IconPath" Property="Fill" Value="{DynamicResource OnPrimaryBrush}" />
                                                            <Setter TargetName="ProfileNameText" Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                                            <Setter TargetName="ActiveCheck" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
