<UserControl x:Class="EyeFocus.UI.Views.DisplayDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="840"
              FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
              SnapsToDevicePixels="True"
              UseLayoutRounding="True"
              TextOptions.TextFormattingMode="Ideal"
              TextOptions.TextRenderingMode="ClearType"
              RenderOptions.ClearTypeHint="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,18,24,22" HorizontalAlignment="Stretch">

            <!-- 1. TOP HEADER & LIVE STATUS PILL -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Category, Title & Subtitle (Crisp Segoe UI Variable Display) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="DISPLAY" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,3" />
                    <TextBlock Text="Optimize Your Display"
                               FontFamily="Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontWeight="Bold" FontSize="28" Foreground="{DynamicResource OnSurfaceBrush}" />
                    <TextBlock Text="Reduce eye strain and create a more comfortable visual experience."
                               FontSize="13" Foreground="{DynamicResource OutlineBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right: Status Pill Button (Toggle Pause / Active) -->
                <Button Grid.Column="1" Command="{Binding TogglePauseCommand}" VerticalAlignment="Center" Cursor="Hand" ToolTip="{Binding PauseButtonToolTip}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="{DynamicResource SurfaceBrightBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="PillBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20" Padding="14,7" SnapsToDevicePixels="True">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
                                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{Binding StatusPillDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusPillText}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. TWO-COLUMN TOP CARDS: BRIGHTNESS & COLOR TEMPERATURE -->
            <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT CARD: BRIGHTNESS -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrightBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource BrightnessHeaderCircleBgBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSun}" Fill="{DynamicResource BrightnessHeaderCircleFgBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Brightness" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OnSurfaceBrush}" />
                                <TextBlock Text="Adjust display brightness" FontSize="11" Foreground="{DynamicResource OutlineBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Percentage Pill Badge -->
                            <Border Grid.Column="2" Background="{DynamicResource BrightnessBadgeBackgroundBrush}" BorderBrush="{DynamicResource BrightnessBadgeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Brightness, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrightnessBadgeForegroundBrush}" />
                            </Border>
                        </Grid>

                        <!-- Slider Row (Dynamic Teal Fill + Clean White Thumb) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path Data="{StaticResource IconSunDim}" Fill="{DynamicResource OutlineBrush}" Stretch="Uniform" />
                            </Viewbox>

                            <Slider Grid.Column="1" Style="{StaticResource M3SliderStyle}"
                                    Value="{Binding Brightness, Mode=TwoWay}"
                                    Minimum="10" Maximum="100"
                                    SmallChange="1" LargeChange="5"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseWheel="OnBrightnessSliderMouseWheel"
                                    PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
                                    MouseMove="OnSliderMouseMove"
                                    PreviewMouseLeftButtonUp="OnSliderPreviewMouseLeftButtonUp"
                                    Tag="{StaticResource SliderBrightnessFillBrush}"
                                    Margin="10,0"
                                    VerticalAlignment="Center" />

                            <Viewbox Grid.Column="2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path Data="{StaticResource IconSunBright}" Fill="{DynamicResource OutlineBrush}" Stretch="Uniform" />
                            </Viewbox>
                        </Grid>

                        <!-- Hardware / Reset Sub-info (Aligned strictly with slider track) -->
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Hardware Status (Short, single-line) -->
                                <TextBlock Grid.Column="0" Text="{Binding HardwareControlBadgeText}" FontWeight="Medium" FontSize="9" Foreground="{DynamicResource OutlineBrush}" VerticalAlignment="Center" />

                                <!-- Center: Reset Button -->
                                <Button Grid.Column="1" Style="{StaticResource M3TonalButtonStyle}" Command="{Binding ResetBrightnessCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,1" Height="20" ToolTip="Reset brightness to profile default">
                                    <TextBlock Text="Reset" FontSize="9" FontWeight="SemiBold" />
                                </Button>

                                <!-- Right: Target Comfort (Short, single-line) -->
                                <TextBlock Grid.Column="2" Text="Target 40%" FontWeight="Medium" FontSize="9" Foreground="{DynamicResource OutlineBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- RIGHT CARD: COLOR TEMPERATURE -->
                <Border Grid.Column="2" Background="{DynamicResource SurfaceBrightBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource KelvinHeaderCircleBgBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconThermometer}" Fill="{DynamicResource KelvinHeaderCircleFgBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Color Temperature" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OnSurfaceBrush}" />
                                <TextBlock Text="Reduce blue light for eye comfort" FontSize="11" Foreground="{DynamicResource OutlineBrush}" Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Kelvin Pill Badge -->
                            <Border Grid.Column="2" Background="{DynamicResource KelvinBadgeBackgroundBrush}" BorderBrush="{DynamicResource KelvinBadgeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Kelvin, StringFormat='{}{0}K'}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource KelvinBadgeForegroundBrush}" />
                            </Border>
                        </Grid>

                        <!-- Slider Row (Dynamic Amber Fill + Clean White Thumb) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <Viewbox Grid.Column="0" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path Data="{StaticResource IconCoolSun}" Fill="{DynamicResource OutlineBrush}" Stretch="Uniform" />
                            </Viewbox>

                            <Slider Grid.Column="1" Style="{StaticResource M3SliderStyle}"
                                    Value="{Binding Kelvin, Mode=TwoWay}"
                                    Minimum="2500" Maximum="7500"
                                    SmallChange="50" LargeChange="250"
                                    IsMoveToPointEnabled="True"
                                    PreviewMouseWheel="OnKelvinSliderMouseWheel"
                                    PreviewMouseLeftButtonDown="OnSliderPreviewMouseLeftButtonDown"
                                    MouseMove="OnSliderMouseMove"
                                    PreviewMouseLeftButtonUp="OnSliderPreviewMouseLeftButtonUp"
                                    Tag="{StaticResource SliderKelvinFillBrush}"
                                    Margin="10,0"
                                    VerticalAlignment="Center" />

                            <Viewbox Grid.Column="2" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path Data="{StaticResource IconWarmSun}" Fill="#F59E0B" Stretch="Uniform" />
                            </Viewbox>
                        </Grid>

                        <!-- Descriptive Labels (Cooler vs Warmer) (Aligned strictly with slider track) -->
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="20" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1" Margin="10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Cooler (Short, single-line) -->
                                <TextBlock Grid.Column="0" Text="Cool (6500K)" FontWeight="Medium" FontSize="9" Foreground="{DynamicResource OutlineBrush}" VerticalAlignment="Center" />

                                <!-- Center: Reset Button -->
                                <Button Grid.Column="1" Style="{StaticResource M3TonalButtonStyle}" Command="{Binding ResetKelvinCommand}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,1" Height="20" ToolTip="Reset color temperature to profile default">
                                    <TextBlock Text="Reset" FontSize="9" FontWeight="SemiBold" />
                                </Button>

                                <!-- Right: Warmer (Short, single-line) -->
                                <TextBlock Grid.Column="2" Text="Warm (2700K)" FontWeight="Medium" FontSize="9" Foreground="#D97706" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. DAY & NIGHT MODE SCHEDULE CARD -->
            <Border Background="{DynamicResource SurfaceBrightBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="16" Padding="20,18" Margin="0,0,0,18">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ScheduleHeaderCircleBgBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconClock}" Fill="{DynamicResource ScheduleHeaderCircleFgBrush}" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Day &amp; Night Mode" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="Automatically adjust your display throughout the day." FontSize="11.5" Foreground="{DynamicResource OutlineBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Schedule Enabled Toggle Switch -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox Style="{StaticResource M3SwitchStyle}" 
                                      IsChecked="{Binding IsAutomaticDayNightEnabled, Mode=TwoWay}" 
                                      ToolTip="Toggle automatic day/night schedule"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding ScheduleToggleText}" 
                                           FontSize="12.5" 
                                           FontWeight="SemiBold" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource OutlineBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAutomaticDayNightEnabled}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </CheckBox>
                            <Button Style="{StaticResource M3IconButtonStyle}" 
                                    Command="{Binding ConfigureAutoDayNightCommand}" 
                                    Width="26" Height="26" 
                                    Padding="0"
                                    Margin="12,0,0,0" 
                                    ToolTip="Configure schedule hours"
                                    VerticalAlignment="Center">
                                <Path Data="{StaticResource IconSettings}" 
                                      Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}" 
                                      Width="13" Height="13" 
                                      Stretch="Uniform" 
                                      HorizontalAlignment="Center" 
                                      VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Schedule Visualization: 3-Section Horizontal Layout -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2.8*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="2.3*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Day Mode Box -->
                        <Button Grid.Column="0" Command="{Binding SelectDayModeCommand}" Cursor="Hand" Padding="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource DayModeCardBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DayModeCardBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="BoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="16,14" SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#F59E0B" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsDayModeActive}" Value="True">
                                                        <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#F59E0B" />
                                                        <Setter TargetName="BoxBorder" Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource DayModeIconCircleBackgroundBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconSun}" Fill="#F59E0B" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                         <TextBlock Text="Day Mode" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Clear and vibrant for productivity during the day." FontSize="10.5" Foreground="{DynamicResource OutlineBrush}" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="14.5" LineStackingStrategy="BlockLineHeight" />
                                <!-- Time Badge Pill -->
                                <Border Background="{DynamicResource DayModeTimeBadgeBackgroundBrush}" BorderBrush="{DynamicResource DayModeTimeBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,3.5" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding DayScheduleRange}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource DayModeTimeBadgeForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- Center: Timeline Bar Visualization (Live Real-Time Synced) -->
                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                            <!-- Dynamic Proportions: Col 0: Before DayStart | Col 1: Daytime | Col 2: Nighttime -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding TimelineCol0Weight, FallbackValue='29*'}" />
                                <ColumnDefinition Width="{Binding TimelineCol1Weight, FallbackValue='46*'}" />
                                <ColumnDefinition Width="{Binding TimelineCol2Weight, FallbackValue='25*'}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Sun & Moon Icons -->
                            <!-- Sun Icon at the start of Daytime segment -->
                            <Path Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Margin="-6,0,0,10"
                                  Data="{StaticResource IconSun}" Fill="#FEB836"
                                  Width="24" Height="24" Stretch="Uniform" />
                            <!-- Moon Icon centered above Nighttime segment -->
                            <Path Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Margin="0,0,0,10"
                                  Data="{StaticResource IconMoon}" Fill="{DynamicResource TimelineNightTrackBrush}"
                                  Width="20" Height="20" Stretch="Uniform" />

                            <!-- Row 1: 24-Hour Dynamic Sky Gradient Track Pill (Smooth Continuous Transitions) -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                    Height="12" CornerRadius="6"
                                    Background="{Binding TimelineSkyGradientBrush}"
                                    SnapsToDevicePixels="True"
                                    VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.12" Color="#000000" />
                                </Border.Effect>
                            </Border>

                            <!-- Live Current Time Indicator Overlay (Spans all columns) -->
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                  VerticalAlignment="Center" Height="28">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding TimelineLeftWeight, FallbackValue='50*'}" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{Binding TimelineRightWeight, FallbackValue='50*'}" />
                                </Grid.ColumnDefinitions>

                                <!-- Pin Container at Current Time Position -->
                                <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Live Floating Time Tag below the bar -->
                                    <Canvas Height="0" Width="0" ClipToBounds="False">
                                        <Border Canvas.Left="-24" Canvas.Top="16"
                                                Background="{DynamicResource SurfaceContainerBrush}"
                                                BorderBrush="{Binding CurrentTimePinBrush}"
                                                BorderThickness="1" CornerRadius="4"
                                                Padding="4.5,1.5" SnapsToDevicePixels="True">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#000000" />
                                            </Border.Effect>
                                            <TextBlock Text="{Binding CurrentTimeText}"
                                                       FontSize="9" FontWeight="Bold"
                                                       Foreground="{DynamicResource OnSurfaceBrush}"
                                                       FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif" />
                                        </Border>
                                    </Canvas>

                                    <!-- Vertical Indicator Needle Line -->
                                    <Line X1="0" Y1="0" X2="0" Y2="20"
                                          Stroke="{Binding CurrentTimePinBrush}" StrokeThickness="1.5"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True" />

                                    <!-- Pulsing Aura Ring with Smooth Breathing Animation -->
                                    <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Fill="{Binding CurrentTimePinBrush}" Opacity="0.35"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <ScaleTransform ScaleX="1.0" ScaleY="1.0" />
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="0.2" To="0.75" Duration="0:0:1.3"
                                                                         AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         From="0.8" To="1.3" Duration="0:0:1.3"
                                                                         AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         From="0.8" To="1.3" Duration="0:0:1.3"
                                                                         AutoReverse="True">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>

                                    <!-- Solid Center Pin Core -->
                                    <Border Width="10" Height="10" CornerRadius="5"
                                            Background="#FFFFFF"
                                            BorderBrush="{Binding CurrentTimePinBrush}"
                                            BorderThickness="2"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.25" Color="#000000" />
                                        </Border.Effect>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Row 2: Time Labels under schedule boundaries -->
                            <!-- Label 1: Day start time -->
                            <Canvas Grid.Row="2" Grid.Column="1" Height="26" ClipToBounds="False">
                                <TextBlock Text="{Binding DayTimeFormatted}" Canvas.Left="-26" Canvas.Top="18"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OutlineBrush}" />
                            </Canvas>
                            <!-- Label 2: Night start time -->
                            <Canvas Grid.Row="2" Grid.Column="2" Height="26" ClipToBounds="False">
                                <TextBlock Text="{Binding NightTimeFormatted}" Canvas.Left="-26" Canvas.Top="18"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OutlineBrush}" />
                            </Canvas>
                        </Grid>

                        <!-- Right: Night Mode Box -->
                        <Button Grid.Column="4" Command="{Binding SelectNightModeCommand}" Cursor="Hand" Padding="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource NightModeCardBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource NightModeCardBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="NightBoxBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="16,14" SnapsToDevicePixels="True">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="NightBoxBorder" Property="BorderBrush" Value="#0284C7" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsNightModeActive}" Value="True">
                                                        <Setter TargetName="NightBoxBorder" Property="BorderBrush" Value="#0284C7" />
                                                        <Setter TargetName="NightBoxBorder" Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource NightModeIconCircleBackgroundBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconNight}" Fill="{DynamicResource NightModeIconCircleForegroundBrush}" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Night Mode" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Warmer, softer light for comfortable evening viewing." FontSize="10.5" Foreground="{DynamicResource OutlineBrush}" TextWrapping="Wrap" Margin="0,0,0,12" LineHeight="14.5" LineStackingStrategy="BlockLineHeight" />
                                <!-- Time Badge Pill -->
                                <Border Background="{DynamicResource NightModeTimeBadgeBackgroundBrush}" BorderBrush="{DynamicResource NightModeTimeBadgeBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9,3.5" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding NightScheduleRange}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource NightModeTimeBadgeForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. DISPLAY PROFILES GRID -->
            <Border Background="{DynamicResource SurfaceBrightBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="16" Padding="20,18">
                <StackPanel>
                    <!-- Header -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="{DynamicResource ProfilesHeaderCircleBgBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconGrid}" Fill="{DynamicResource ProfilesHeaderCircleFgBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Display Profiles" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="Choose a preset that fits your activity, or customize your own." FontSize="11.5" Foreground="{DynamicResource OutlineBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- + Create Custom Profile Button -->
                        <Button Grid.Column="2" Style="{StaticResource M3OutlinedButtonStyle}" Command="{Binding CreateCustomProfileCommand}" Padding="14,6" Height="32" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconPlus}" Fill="{DynamicResource PrimaryBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Create Custom Profile" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- 3x3 Profiles UniformGrid (8 Profile Cards) -->
                    <ItemsControl ItemsSource="{Binding ProfileCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Id}"
                                        Margin="5" Padding="0" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceBrightBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource OutlineVariantBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="CardBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="14" Padding="14,14" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <!-- Colored Icon Circle (38x38) -->
                                                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="{Binding IconBgBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                    <Path Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometryConverter}}"
                                                                          Fill="{Binding IconFgBrush}"
                                                                          Width="17" Height="17" Stretch="Uniform"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>

                                                                <!-- Name & Description -->
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource OnSurfaceBrush}" />
                                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource OutlineBrush}" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="32" LineHeight="15" LineStackingStrategy="BlockLineHeight" />
                                                                </StackPanel>

                                                                <!-- Active Checkmark Badge -->
                                                                <Border x:Name="ActiveBadge" Grid.Column="2" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource PrimaryBrush}" Visibility="Collapsed" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                    <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource OnPrimaryBrush}" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SurfaceContainerBrush}" />
                                                            </Trigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="1.5" />
                                                                <Setter TargetName="ActiveBadge" Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
