<UserControl x:Class="EyeFocus.UI.Views.AutoDayNightConfigModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="560" d:DesignWidth="480">

    <!-- Crisp, High-Contrast Modal Container (Matches Dashboard Precision) -->
    <Border Background="{DynamicResource SurfaceContainerBrush}" BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
        <StackPanel>
            <!-- 1. Header Bar -->
            <Grid Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="{DynamicResource PrimaryContainerBrush}" Margin="0,0,8,0">
                        <Path Data="{StaticResource IconSun}" Fill="{DynamicResource PrimaryBrush}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Automatic Day/Night" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource OnSurfaceBrush}" />
                        <TextBlock Text="Configure automatic display mode switching" FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <Button Style="{StaticResource M3IconButtonStyle}" Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Width="28" Height="28" Padding="0" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource OnSurfaceVariantBrush}"
                          Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </Grid>

            <!-- 2. Time Detection Section -->
            <Border Style="{StaticResource M3CardStyle}" Background="{DynamicResource SurfaceContainerHighBrush}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="TIME DETECTION" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                    <TextBlock Text="Choose whether to follow Windows local time or manually set a specific timezone." FontSize="11" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,8" />

                    <!-- Segmented Control -->
                    <Border Background="{DynamicResource SurfaceContainerBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="2" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource M3SegmentedItemStyle}" Content="System Automatic" GroupName="TimeDetectionGroup"
                                         IsChecked="{Binding IsSystemAutomatic, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource M3SegmentedItemStyle}" Content="Manual" GroupName="TimeDetectionGroup"
                                         IsChecked="{Binding IsManual, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <!-- When System Automatic: Info Card -->
                    <Border Background="{DynamicResource SurfaceContainerBrush}" BorderBrush="{DynamicResource OutlineVariantBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,2">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSystemAutomatic}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource IconInfo}" Fill="{DynamicResource PrimaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SystemInfoText}" FontSize="11" Foreground="{DynamicResource OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- When Manual: Time Zone Dropdown -->
                    <StackPanel Margin="0,4,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManual}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="TIME ZONE" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,4" />
                        <ComboBox Style="{StaticResource M3ComboBoxStyle}"
                                  ItemsSource="{Binding TimeZones}"
                                  SelectedValuePath="Id"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedTimeZoneId, Mode=TwoWay}"
                                  Height="30" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 3. Day and Night Schedule Times -->
            <Border Style="{StaticResource M3CardStyle}" Background="{DynamicResource SurfaceContainerHighBrush}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="SCHEDULE TIMES" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,0,0,8" />

                    <!-- Day Start Time Row -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Day starts at" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="Automatic switching to Day Mode begins at this time." FontSize="10.5" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox Style="{StaticResource M3ComboBoxStyle}" ItemsSource="{Binding Hours}" SelectedValue="{Binding DayHour, Mode=TwoWay}" Width="56" Height="30" />
                            <TextBlock Text=":" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="4,0" />
                            <ComboBox Style="{StaticResource M3ComboBoxStyle}" ItemsSource="{Binding Minutes}" SelectedValue="{Binding DayMinute, Mode=TwoWay}" Width="56" Height="30" />
                        </StackPanel>
                    </Grid>

                    <!-- Night Start Time Row -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Night starts at" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource OnSurfaceBrush}" />
                            <TextBlock Text="Automatic switching to Night Mode begins at this time." FontSize="10.5" Foreground="{DynamicResource OnSurfaceVariantBrush}" Margin="0,1,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ComboBox Style="{StaticResource M3ComboBoxStyle}" ItemsSource="{Binding Hours}" SelectedValue="{Binding NightHour, Mode=TwoWay}" Width="56" Height="30" />
                            <TextBlock Text=":" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource OnSurfaceVariantBrush}" VerticalAlignment="Center" Margin="4,0" />
                            <ComboBox Style="{StaticResource M3ComboBoxStyle}" ItemsSource="{Binding Minutes}" SelectedValue="{Binding NightMinute, Mode=TwoWay}" Width="56" Height="30" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Validation Error Alert (If Any) -->
            <Border Background="#20EF4444" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
            </Border>

            <!-- 5. Action Buttons -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" Style="{StaticResource M3TonalButtonStyle}" Command="{Binding CancelCommand}" Padding="14,6" Height="32">
                    <TextBlock Text="Cancel" Foreground="{DynamicResource OnSecondaryContainerBrush}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                </Button>
                <Button Grid.Column="3" Style="{StaticResource M3FilledButtonStyle}" Command="{Binding SaveCommand}" Padding="16,6" Height="32">
                    <TextBlock Text="Save Settings" Foreground="{DynamicResource OnPrimaryBrush}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
